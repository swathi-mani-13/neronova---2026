# ==============================================================================
# NERONOVA 2026 - Supabase Environment Variables
# ==============================================================================
# Instructions:
# 1. Create a project at https://supabase.com
# 2. Go to: Project Settings -> API
# 3. Copy "Project URL" and the "anon public" API key
# 4. Create a `.env` file in the project root and paste your values below
#
# SECURITY NOTICE:
# - NEVER put your Supabase `service_role` secret key in this file.
# - ONLY use the `anon public` key in frontend environments.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
